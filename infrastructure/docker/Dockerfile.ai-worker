# AI Worker Dockerfile
FROM python:3.11-slim-bookworm as builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc gfortran libopenblas-dev liblapack-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY services/ai_worker/requirements.txt ./ai_worker/

RUN python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r ./ai_worker/requirements.txt

FROM python:3.11-slim-bookworm

LABEL maintainer="AI Platform Team"
LABEL service="ai_worker"

WORKDIR /app

# Install ML runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libopenblas0 liblapack3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FLASK_APP="services.ai_worker.main:create_app"

COPY . .

RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app && \
    mkdir -p /tmp/ai_worker_cache && \
    chown appuser:appuser /tmp/ai_worker_cache

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000
VOLUME ["/tmp/ai_worker_cache"]

CMD ["python", "-m", "services.ai_worker.main"]
