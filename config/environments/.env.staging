# Staging Environment Configuration
# Load with: source config/environments/.env.staging

# Python & Flask
FLASK_ENV=staging
FLASK_DEBUG=false
LOG_LEVEL=INFO

# MongoDB (use managed service)
MONGODB_USER=staging_user
MONGODB_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER

# RabbitMQ (use managed service)
RABBITMQ_USER=staging_user
RABBITMQ_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER

# Email Service
EMAIL_SMTP_HOST=staging-smtp.company.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=staging@company.com
EMAIL_SMTP_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER
EMAIL_FROM_ADDRESS=noreply-staging@company.com

# JWT
JWT_SECRET_KEY=CHANGE_ME_IN_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI Worker
AI_WORKER_MAX_WORKERS=8
AI_MODEL_CACHE_PATH=/var/cache/ai_models
AI_MODEL_TIMEOUT_SECONDS=600

# Notification Service
NOTIFICATION_QUEUE_SIZE=5000
NOTIFICATION_RETRY_MAX=5
NOTIFICATION_RETRY_DELAY_SECONDS=120

# Service URLs
AUTH_SERVICE_URL=https://auth-staging.company.com
API_SERVICE_URL=https://api-staging.company.com
AI_WORKER_URL=https://ai-staging.company.com
NOTIFICATION_SERVICE_URL=https://notifications-staging.company.com

# Monitoring & Debugging
ENABLE_PROFILING=false
ENABLE_DETAILED_LOGGING=false
