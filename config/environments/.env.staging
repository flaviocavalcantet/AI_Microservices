# Staging Environment Configuration
# IMPORTANT: This file should not contain real production secrets
# Real secrets should come from environment variables or secrets manager

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=staging
SERVICE_NAME=api_service
SERVICE_PORT=5000
SERVICE_HOST=0.0.0.0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# DATABASE
# ============================================
# Staging database (placeholder - use real URL in deployment)
MONGODB_URI=mongodb://admin:password@mongodb-staging:27017/api_service?authSource=admin

# ============================================
# MESSAGE QUEUE
# ============================================
RABBITMQ_URL=amqp://guest:password@rabbitmq-staging:5672/

# ============================================
# CACHING
# ============================================
REDIS_URL=redis://redis-staging:6379/0

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# IMPORTANT: Set JWT_SECRET_KEY via environment variable or secrets manager
# Do NOT commit real secrets here
JWT_SECRET_KEY=SET_VIA_ENVIRONMENT_OR_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=https://staging.company.com,https://staging-dashboard.company.com

# ============================================
# API DOCUMENTATION
# ============================================
SWAGGER_ENABLED=true
OPENAPI_VERSION=3.0.3
