# ============================================

# Development Environment Configuration

# Docker Compose Local Development

# ============================================

# ============================================

# ENVIRONMENT

# ============================================

FLASK_ENV=development
SERVICE_NAME=api_service
SERVICE_PORT=5000
SERVICE_HOST=0.0.0.0

# ============================================

# LOGGING

# ============================================

LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ============================================

# DATABASE

# ============================================

MONGODB_URI=mongodb://admin:admin123@localhost:27017/api_service?authSource=admin

# ============================================

# MESSAGE QUEUE

# ============================================

RABBITMQ_URL=amqp://appuser:apppass123@localhost:5672/

# ============================================

# CACHING

# ============================================

REDIS_URL=redis://localhost:6379/0

# ============================================

# SECURITY & AUTHENTICATION

# ============================================

JWT_SECRET_KEY=dev-secret-key-only-for-testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================

# AI WORKER

# ============================================

AI_WORKER_MAX_WORKERS=4
AI_MODEL_TIMEOUT_SECONDS=300

# HuggingFace model cache

HF_HOME=/hf_cache

# Legacy cache location (if still referenced by code)

AI_MODEL_CACHE_PATH=/tmp/ai_worker_cache

# ============================================

# INTERNAL SERVICE URLS

# ============================================

AUTH_SERVICE_URL=http://localhost:5000
API_SERVICE_URL=http://localhost:5000
AI_WORKER_URL=http://localhost:5000
NOTIFICATION_SERVICE_URL=http://localhost:5000

# ============================================

# CORS

# ============================================

CORS_ALLOWED_ORIGINS=[http://localhost:3000,http://localhost:5000,http://localhost:8000](http://localhost:3000,http://localhost:5000,http://localhost:8000)

# ============================================

# API DOCUMENTATION

# ============================================

SWAGGER_ENABLED=true
OPENAPI_VERSION=3.0.3

# ============================================

# MONITORING & DEBUGGING

# ============================================

ENABLE_PROFILING=true
ENABLE_DETAILED_LOGGING=true
