# Development Environment Configuration
# For local development on your machine

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=development
SERVICE_NAME=api_service
SERVICE_PORT=5000
SERVICE_HOST=0.0.0.0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ============================================
# DATABASE
# ============================================
# Local development database
MONGODB_URI=mongodb://admin:admin123@localhost:27017/api_service?authSource=admin

# ============================================
# MESSAGE QUEUE
# ============================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ============================================
# CACHING
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# Development secret (not for production!)
JWT_SECRET_KEY=dev-secret-key-only-for-testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS
# ============================================
# Allow all origins in development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000

# ============================================
# API DOCUMENTATION
# ============================================
SWAGGER_ENABLED=true
OPENAPI_VERSION=3.0.3
