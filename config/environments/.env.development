# Development Environment Configuration
# Load with: source config/environments/.env.development

# Python & Flask
FLASK_ENV=development
FLASK_DEBUG=true
LOG_LEVEL=DEBUG

# MongoDB
MONGODB_USER=admin
MONGODB_PASSWORD=admin123

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Email Service (configure for development)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=noreply@aiplatform.local

# JWT
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI Worker
AI_WORKER_MAX_WORKERS=4
AI_MODEL_CACHE_PATH=/tmp/ai_worker_cache
AI_MODEL_TIMEOUT_SECONDS=300

# Notification Service
NOTIFICATION_QUEUE_SIZE=1000
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_RETRY_DELAY_SECONDS=60

# Service URLs for internal communication
AUTH_SERVICE_URL=http://auth-service:5000
API_SERVICE_URL=http://api-service:5000
AI_WORKER_URL=http://ai-worker:5000
NOTIFICATION_SERVICE_URL=http://notification-service:5000

# Monitoring & Debugging
ENABLE_PROFILING=true
ENABLE_DETAILED_LOGGING=true
