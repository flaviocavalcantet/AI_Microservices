# Production Environment Configuration
# ⚠️  DANGER: DO NOT COMMIT THIS FILE TO VERSION CONTROL
# ⚠️  Real production secrets should come from:
#     - Kubernetes Secrets
#     - AWS Secrets Manager / Parameter Store
#     - Azure Key Vault
#     - HashiCorp Vault
#     - Environment variables set by deployment system

# This is an EXAMPLE of what production configuration looks like
# It has placeholder values that will be overridden by actual secrets

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=production
SERVICE_NAME=api_service
SERVICE_PORT=5000
SERVICE_HOST=0.0.0.0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ============================================
# DATABASE
# ============================================
# IMPORTANT: Set via Kubernetes Secret or cloud secrets manager
# Never commit real database credentials
MONGODB_URI=OVERRIDE_VIA_K8S_SECRET_OR_SECRETS_MANAGER

# ============================================
# MESSAGE QUEUE
# ============================================
RABBITMQ_URL=OVERRIDE_VIA_K8S_SECRET_OR_SECRETS_MANAGER

# ============================================
# CACHING
# ============================================
REDIS_URL=OVERRIDE_VIA_K8S_SECRET_OR_SECRETS_MANAGER

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# CRITICAL: Must be set via Kubernetes Secret or cloud secrets manager
# Must be:
# - At least 32 characters
# - Cryptographically random
# - Different from development/staging values
# - Never exposed in code or logs
JWT_SECRET_KEY=OVERRIDE_VIA_K8S_SECRET_OR_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS
# ============================================
# Strict CORS in production
CORS_ALLOWED_ORIGINS=https://company.com,https://app.company.com

# ============================================
# API DOCUMENTATION
# ============================================
# Disable Swagger in production for security
SWAGGER_ENABLED=false
OPENAPI_VERSION=3.0.3

# ============================================
# DEPLOYMENT NOTES
# ============================================
# To deploy with this configuration:
#
# 1. For Kubernetes:
#    kubectl create secret generic api_service-secrets \
#      --from-literal=MONGODB_URI='...' \
#      --from-literal=RABBITMQ_URL='...' \
#      --from-literal=JWT_SECRET_KEY='...' \
#      -n production
#
#    Then reference in pod spec:
#    env:
#      - name: MONGODB_URI
#        valueFrom:
#          secretKeyRef:
#            name: api_service-secrets
#            key: MONGODB_URI
#
# 2. For AWS:
#    aws secretsmanager create-secret \
#      --name api_service/prod \
#      --secret-string '{"MONGODB_URI":"...","JWT_SECRET_KEY":"..."}'
#
# 3. For Docker:
#    docker run --env-file .env.production.secrets ...
#    (but never commit .env.production.secrets!)
#
# 4. Generate secure JWT secret:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://company.com,https://www.company.com
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
MAX_CONTENT_LENGTH_MB=100
