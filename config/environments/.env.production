# Production Environment Configuration
# Load via secure secrets management (Kubernetes Secrets, AWS Secrets Manager, etc.)
# NEVER commit actual production values to version control

# Python & Flask
FLASK_ENV=production
FLASK_DEBUG=false
LOG_LEVEL=WARNING

# MongoDB (use managed database service)
MONGODB_USER=SECRETS_MANAGER
MONGODB_PASSWORD=SECRETS_MANAGER

# RabbitMQ (use managed message broker)
RABBITMQ_USER=SECRETS_MANAGER
RABBITMQ_PASSWORD=SECRETS_MANAGER

# Email Service
EMAIL_SMTP_HOST=SECRETS_MANAGER
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=SECRETS_MANAGER
EMAIL_SMTP_PASSWORD=SECRETS_MANAGER
EMAIL_FROM_ADDRESS=noreply@company.com

# JWT
JWT_SECRET_KEY=SECRETS_MANAGER
JWT_ALGORITHM=RS256
JWT_EXPIRATION_HOURS=24

# AI Worker
AI_WORKER_MAX_WORKERS=16
AI_MODEL_CACHE_PATH=/var/cache/ai_models
AI_MODEL_TIMEOUT_SECONDS=1200

# Notification Service
NOTIFICATION_QUEUE_SIZE=10000
NOTIFICATION_RETRY_MAX=5
NOTIFICATION_RETRY_DELAY_SECONDS=300

# Service URLs
AUTH_SERVICE_URL=https://auth-api.company.com
API_SERVICE_URL=https://api.company.com
AI_WORKER_URL=https://ai-worker.company.com
NOTIFICATION_SERVICE_URL=https://notifications.company.com

# Monitoring & Debugging
ENABLE_PROFILING=false
ENABLE_DETAILED_LOGGING=false

# Additional Production Settings
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://company.com,https://www.company.com
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
MAX_CONTENT_LENGTH_MB=100
