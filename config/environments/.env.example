# Environment Variables Template
# Copy this file to create environment-specific configs:
# - .env.development (local development)
# - .env.staging (staging environment)
# - .env.production (production - use secrets management!)

# ============ Python & Flask Configuration ============
FLASK_ENV=development
FLASK_DEBUG=false
LOG_LEVEL=INFO

# ============ Database Configuration ============
# MongoDB connection string or credentials
MONGODB_URI=mongodb://admin:admin123@localhost:27017/ai_platform?authSource=admin
MONGODB_USER=admin
MONGODB_PASSWORD=admin123

# ============ Message Broker Configuration ============
# RabbitMQ connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============ Caching Configuration ============
# Redis connection
REDIS_URL=redis://localhost:6379/0

# ============ Email Service Configuration ============
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM_ADDRESS=noreply@company.com
EMAIL_FROM_NAME="AI Platform"

# ============ Authentication Configuration ============
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ============ AI Worker Configuration ============
AI_WORKER_MAX_WORKERS=4
AI_WORKER_TIMEOUT_SECONDS=300
AI_MODEL_CACHE_PATH=/tmp/ai_models
AI_MODEL_CACHE_SIZE_GB=10

# ============ Notification Service Configuration ============
NOTIFICATION_QUEUE_SIZE=1000
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_RETRY_DELAY_SECONDS=60

# ============ Service URLs (for internal communication) ============
AUTH_SERVICE_URL=http://auth-service:5000
API_SERVICE_URL=http://api-service:5000
AI_WORKER_URL=http://ai-worker:5000
NOTIFICATION_SERVICE_URL=http://notification-service:5000

# ============ Monitoring & Debugging ============
ENABLE_PROFILING=false
ENABLE_DETAILED_LOGGING=false
SENTRY_DSN=https://your-sentry-project@sentry.io/your-project-id

# ============ Security ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
MAX_CONTENT_LENGTH_MB=100
SECURE_HEADERS_ENABLED=true

# ============ Environment Identifier ============
ENVIRONMENT=development
SERVICE_NAME=ai-platform
SERVICE_VERSION=1.0.0
