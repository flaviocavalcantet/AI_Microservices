# Environment Configuration Template
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env with real secrets to version control

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=development
SERVICE_NAME=api_service
SERVICE_PORT=5000
SERVICE_HOST=0.0.0.0

# ============================================
# LOGGING
# ============================================
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: json (for production) or text (for development)
LOG_FORMAT=text

# ============================================
# DATABASE
# ============================================
# Format: mongodb://[username]:[password]@[host]:[port]/[database]?authSource=admin
MONGODB_URI=mongodb://admin:admin123@localhost:27017/api_service?authSource=admin

# ============================================
# MESSAGE QUEUE (RabbitMQ)
# ============================================
# Format: amqp://[username]:[password]@[host]:[port]/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ============================================
# CACHING (Redis)
# ============================================
# Format: redis://:[password]@[host]:[port]/[database]
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# IMPORTANT: Change in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-secret-key-only-for-testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# API DOCUMENTATION
# ============================================
SWAGGER_ENABLED=true
OPENAPI_VERSION=3.0.3

# ============================================
# OPTIONAL: EMAIL (for notifications, password reset)
# ============================================
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password
# EMAIL_FROM_ADDRESS=noreply@company.com
# EMAIL_FROM_NAME=AI Platform

# ============================================
# OPTIONAL: AI/ML CONFIGURATION
# ============================================
# MODEL_CACHE_DIR=/.hf_cache
# MAX_WORKERS=4
# GPU_ENABLED=false
# GPU_DEVICE=cuda:0
NOTIFICATION_RETRY_DELAY_SECONDS=60

# ============ Service URLs (for internal communication) ============
AUTH_SERVICE_URL=http://auth_service:5000
API_SERVICE_URL=http://api_service:5000
AI_WORKER_URL=http://ai_worker:5000
NOTIFICATION_SERVICE_URL=http://notification_service:5000

# ============ Monitoring & Debugging ============
ENABLE_PROFILING=false
ENABLE_DETAILED_LOGGING=false
SENTRY_DSN=https://your-sentry-project@sentry.io/your-project-id

# ============ Security ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
MAX_CONTENT_LENGTH_MB=100
SECURE_HEADERS_ENABLED=true

# ============ Environment Identifier ============
ENVIRONMENT=development
SERVICE_NAME=ai-platform
SERVICE_VERSION=1.0.0
