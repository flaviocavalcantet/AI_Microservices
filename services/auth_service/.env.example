# Auth Service — copy to .env and adjust

FLASK_ENV=development
SERVICE_PORT=5000

# JWT (HS256 for dev; use RS256 + JWKS in production)
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service
JWT_AUDIENCE=ai_platform
JWT_ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_EXPIRATION_DAYS=30
# Optional override for refresh JWT TTL (seconds); defaults to REFRESH_TOKEN_EXPIRATION_DAYS
# JWT_REFRESH_TOKEN_SECONDS=2592000

# GitHub OAuth (register app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email

OAUTH_STATE_TTL_MINUTES=10
